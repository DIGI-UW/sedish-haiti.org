# Docker API Version (required for compatibility with newer Docker daemon)
DOCKER_API_VERSION=1.44

# General
CLUSTERED_MODE=false
VERSION=v1.0.0-alpha.1

# Log

DEBUG=1
BASHLOG_FILE=1
BASHLOG_FILE_PATH=platform.log

# Interoperability Layer - OpenHIM
OPENHIM_CORE_INSTANCES=1
OPENHIM_CONSOLE_INSTANCES=1
OPENHIM_MEDIATOR_API_PORT=443
MONGO_SET_COUNT=1
OPENHIM_MONGO_URL=mongodb://mongo-1:27017/openhim
OPENHIM_MONGO_ATNAURL=mongodb://mongo-1:27017/openhim
OPENHIM_CONSOLE_BASE_URL=openhimconsole.sedishtest.live
OPENHIM_API_HOST=openhimcore.sedishtest.live
OPENHIM_CORE_MEDIATOR_HOSTNAME=openhimcomms.sedishtest.live
KC_FRONTEND_URL=https://keycloak.sedishtest.live
KC_OPENHIM_ROOT_URL=https://openhimconsole.sedishtest.live

# FHIR Datastore - HAPI FHIR
HAPI_FHIR_INSTANCES=1
HAPI_FHIR_MAX_REPLICAS_PER_NODE=1
HAPI_FHIR_CPU_LIMIT=2
HAPI_FHIR_MEMORY_LIMIT=4G
HAPI_FHIR_CPU_RESERVE=0.5
HAPI_FHIR_MEMORY_RESERVE=1G
HAPI_DB_SET=postgres-1:5432
HF_POSTGRESQL_USERNAME=postgres
HF_POSTGRESQL_PASSWORD=instant101
HF_JAVA_OPTS=-Xmx2g -Xms1g
REPMGR_PARTNER_NODES=postgres-1
POSTGRES_REPLICA_SET=postgres-1:5432


# Reverse Proxy - Nginx
REVERSE_PROXY_INSTANCES=1
DOMAIN_NAME=sedishtest.live

# Core subdomains (always enabled) - use SUBDOMAIN_CORE_<NAME>=<label> pattern
SUBDOMAIN_CORE_OPENCR=opencr
SUBDOMAIN_CORE_OPENHIMCOMMS=openhimcomms
SUBDOMAIN_CORE_OPENHIMCORE=openhimcore
SUBDOMAIN_CORE_OPENHIMCONSOLE=openhimconsole
SUBDOMAIN_CORE_KEYCLOAK=keycloak
SUBDOMAIN_CORE_GRAFANA=grafana

# iSantePlus instance subdomains - env var name matches docker service name
SUBDOMAIN_CORE_ISANTEPLUS=hueh
SUBDOMAIN_CORE_ISANTEPLUS2=lapaix
SUBDOMAIN_CORE_ISANTEPLUS3=ofatma
SUBDOMAIN_CORE_ISANTEPLUS4=foyer-saint-camille
SUBDOMAIN_CORE_ISANTEPLUS5=klinik-eritaj
SUBDOMAIN_CORE_ISANTEPLUS6=ofatma-sonapi
SUBDOMAIN_CORE_ISANTEPLUS7=gressier
SUBDOMAIN_CORE_ISANTEPLUS8=pestel
SUBDOMAIN_CORE_ISANTEPLUS9=stdemiragoane
SUBDOMAIN_CORE_ISANTEPLUS10=bethel-fdn

# Dev-only subdomains (enabled with -d flag) - use SUBDOMAIN_DEV_<NAME>=<label> pattern
SUBDOMAIN_DEV_SHR=shr

STAGING=false
INSECURE=false
