{
  "id": "message-bus-kafka",
  "name": "Message Bus Kafka Package",
  "description": "Apache Kafka message bus for robust publish-subscribe message streaming",
  "version": "1.0.0",
  "type": "infrastructure",
  "dependencies": [],
  "environmentVariables": {
    "KAFKA_IMAGE": "apache/kafka:4.0.1",
    "KAFKA_CLUSTER_ID": "YWMxNzMwM2Y3MWFhNDA2Nz",
    "KAFKA_REPLICAS": "1",
    "KAFKA_HOSTS": "kafka-01:9092",
    "KAFKA_CPU_LIMIT": "0",
    "KAFKA_CPU_RESERVE": "0.05",
    "KAFKA_MEMORY_LIMIT": "3G",
    "KAFKA_MEMORY_RESERVE": "500M",
    "KAFKA_TOPICS": "2xx,2xx-async,3xx,reprocess,errors,metrics"
  }
}
