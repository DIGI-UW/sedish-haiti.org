        {
          "refId": "A",
          "method": "POST",
          "urlPath": "/analytics/query",
          "body": "{\n  \"collection\": \"labresults\",\n  \"type\": \"aggregate\",\n  \"pipeline\": [\n    { \"$match\": { \n      \"$and\": [\n        { \"createdAt\": { \"$gte\": { \"$toDate\": \"${__from:date}\" }, \"$lte\": { \"$toDate\": \"${__to:date}\" } } },\n        { \"$expr\": { \"$or\": [ { \"$eq\": [\"$facilityId\", \"${facilityId}\"] }, { \"$eq\": [\"${facilityId}\", \"\"] } ] } }\n      ]\n    }},\n    { \"$group\": { \n      \"_id\": { \"$dateTrunc\": { \"date\": \"$createdAt\", \"unit\": \"day\" } },\n      \"value\": { \"$sum\": 1 }\n    }},\n    { \"$sort\": { \"_id\": 1 } },\n    { \"$project\": { \"time\": \"$_id\", \"value\": 1, \"_id\": 0 } }\n  ]\n}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top facilities by orders",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "MongoDB",
      "targets": [
        {
          "refId": "A",
          "method": "POST",
          "urlPath": "/analytics/query",
          "body": "{\n  \"collection\": \"laborders\",\n  \"type\": \"aggregate\",\n  \"pipeline\": [\n    { \"$match\": { \n      \"createdAt\": { \"$gte\": { \"$toDate\": \"${__from:date}\" }, \"$lte\": { \"$toDate\": \"${__to:date}\" } } }\n    },\n    { \"$group\": { \"_id\": \"$facilityId\", \"count\": { \"$sum\": 1 } } },\n    { \"$sort\": { \"count\": -1 } },\n    { \"$limit\": 20 },\n    { \"$project\": { \"Facility\": \"$_id\", \"Orders\": \"$count\", \"_id\": 0 } }\n  ]\n}"
        }
