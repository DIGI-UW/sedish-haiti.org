    {
      "type": "graph",
      "title": "Orders per day",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 4 },
      "datasource": "MongoDB",
      "targets": [
        {
          "refId": "A",
          "method": "POST",
          "urlPath": "/analytics/query",
          "body": "{\n  \"collection\": \"laborders\",\n  \"type\": \"aggregate\",\n  \"pipeline\": [\n    { \"$match\": { \n      \"$and\": [\n        { \"createdAt\": { \"$gte\": { \"$toDate\": \"${__from:date}\" }, \"$lte\": { \"$toDate\": \"${__to:date}\" } } },\n        { \"$expr\": { \"$or\": [ { \"$eq\": [\"$facilityId\", \"${facilityId}\"] }, { \"$eq\": [\"${facilityId}\", \"\"] } ] } }\n      ]\n    }},\n    { \"$group\": { \n      \"_id\": { \"$dateTrunc\": { \"date\": \"$createdAt\", \"unit\": \"day\" } },\n      \"value\": { \"$sum\": 1 }\n    }},\n    { \"$sort\": { \"_id\": 1 } },\n    { \"$project\": { \"time\": \"$_id\", \"value\": 1, \"_id\": 0 } }\n  ]\n}"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Results per day",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 18, "y": 4 },
