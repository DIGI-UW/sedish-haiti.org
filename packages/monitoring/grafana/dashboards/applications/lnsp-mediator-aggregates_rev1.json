{
  "__inputs": [
    {
      "name": "DS_MONGODB",
      "label": "MongoDB",
      "description": "MongoDB datasource (requires MongoDB Grafana plugin)",
      "type": "datasource",
      "pluginId": "grafana-mongodb-datasource",
      "pluginName": "MongoDB"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-mongodb-datasource",
      "name": "MongoDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "graph",
      "name": "Graph",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Orders submitted",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "MongoDB",
      "targets": [
        {
          "refId": "A",
          "method": "GET",
          "urlPath": "/analytics/orders/submitted",
          "queryParams": "facilityId=${facilityId}&from=${__from:date}&to=${__to:date}",
          "fields": [
            { "name": "value", "jsonPath": "$.value", "type": "number" }
          ]
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat",
      "title": "Orders retrieved (retrievedAt)",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "MongoDB",
      "targets": [
        {
          "refId": "A",
          "method": "GET",
          "urlPath": "/analytics/orders/retrieved",
          "queryParams": "facilityId=${facilityId}&from=${__from:date}&to=${__to:date}",
          "fields": [
            { "name": "value", "jsonPath": "$.value", "type": "number" }
          ]
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat",
      "title": "Orders read (lastReadAt)",
      "id": 9,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": "MongoDB",
      "targets": [
        {
          "refId": "A",
          "method": "GET",
          "urlPath": "/analytics/orders/read",
          "queryParams": "facilityId=${facilityId}&from=${__from:date}&to=${__to:date}",
          "fields": [
            { "name": "value", "jsonPath": "$.value", "type": "number" }
          ]
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "graph",
      "title": "Orders read per day (lastReadAt)",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "MongoDB",
      "targets": [
        {
          "refId": "A",
          "method": "POST",
          "urlPath": "/analytics/query",
          "body": "{\n  \"collection\": \"laborders\",\n  \"type\": \"aggregate\",\n  \"pipeline\": [\n    { \"$match\": { \n      \"$and\": [\n        { \"lastReadAt\": { \"$ne\": null } },\n        { \"lastReadAt\": { \"$gte\": { \"$toDate\": \"${__from:date}\" }, \"$lte\": { \"$toDate\": \"${__to:date}\" } } },\n        { \"$expr\": { \"$or\": [ { \"$eq\": [\"$facilityId\", \"${facilityId}\"] }, { \"$eq\": [\"${facilityId}\", \"\"] } ] } }\n      ]\n    }},\n    { \"$group\": { \n      \"_id\": { \"$dateTrunc\": { \"date\": \"$lastReadAt\", \"unit\": \"day\" } },\n      \"value\": { \"$sum\": 1 }\n    }},\n    { \"$sort\": { \"_id\": 1 } },\n    { \"$project\": { \"time\": \"$_id\", \"value\": 1, \"_id\": 0 } }\n  ]\n}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent orders read (drilldown)",
      "id": 11,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": "MongoDB",
      "targets": [
        {
          "refId": "A",
          "method": "GET",
          "urlPath": "/analytics/orders/recent-read",
          "queryParams": "facilityId=${facilityId}&from=${__from:date}&to=${__to:date}"
        }
      ],
      "options": { "showHeader": true }
    },
